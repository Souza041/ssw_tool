# Copiar para C:\ProgramData\Nexus\local-agent.env e restringir a ACL.
NEXUS_LOCAL_AGENT_SERVER_URL=
NEXUS_LOCAL_AGENT_ID=windows-corporativo-01
NEXUS_LOCAL_AGENT_TOKEN=
NEXUS_LOCAL_AGENT_POLL_SECONDS=5
NEXUS_LOCAL_AGENT_REQUEST_TIMEOUT_SECONDS=15
NEXUS_LOCAL_AGENT_ALLOW_INSECURE_HTTP=false
NEXUS_SSW_REMOTE_AUTH_ENABLED=false
NEXUS_LOCAL_AGENT_SSW_HANDLERS_ENABLED=false
NEXUS_LOCAL_AGENT_SSW_TASKS=ssw.documentos_gce,ssw.op001.nfd,ssw.op001.transporte,ssw.session.close
NEXUS_LOCAL_AGENT_RUNTIME_ENV_FILE=C:\ProgramData\Nexus\ssw-automation.env
NEXUS_OP001_MAX_UPLOAD_BYTES=8388608
