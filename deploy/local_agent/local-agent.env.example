# Arquivo para /etc/nexus/local-agent.env (0600, automacao:automacao).
NEXUS_LOCAL_AGENT_ENABLED=false
NEXUS_SSW_DELEGATION_ENABLED=false
NEXUS_SSW_DELEGATED_TASKS=ssw.documentos_gce,ssw.op001.nfd,ssw.op001.transporte,ssw.session.close
NEXUS_SSW_REMOTE_AUTH_ENABLED=false
NEXUS_SSW_REMOTE_AUTH_AGENT_ID=windows-corporativo-01
NEXUS_SSW_REMOTE_AUTH_BINDINGS_JSON={}
NEXUS_LOCAL_AGENT_OFFLINE_SECONDS=30
NEXUS_LOCAL_AGENT_PAIRING_ENABLED=false
NEXUS_LOCAL_AGENT_PAIRING_TTL_SECONDS=600
NEXUS_LOCAL_AGENT_PAIRED_TASKS=system.ping,ssw.documentos_gce,ssw.op001.nfd,ssw.op001.transporte,ssw.session.close
NEXUS_SSW_REMOTE_AUTH_TIMEOUT_SECONDS=960
NEXUS_SSW_REMOTE_AUTH_REQUEST_TTL_SECONDS=960
NEXUS_SSW_REMOTE_AUTH_PER_MINUTE=5
NEXUS_SSW_REMOTE_AUTH_MAX_PENDING=50
NEXUS_LOCAL_AGENT_METRICS_HOMOLOGATION_ENABLED=false
NEXUS_LOCAL_AGENT_DB=/var/lib/nexus/local-agent.sqlite3
NEXUS_LOCAL_AGENT_TOKENS_JSON={}
NEXUS_LOCAL_AGENT_ALLOWED_TASKS=system.ping
NEXUS_LOCAL_AGENT_AGENT_TASKS_JSON={}
NEXUS_LOCAL_AGENT_LEASE_SECONDS=120
NEXUS_LOCAL_AGENT_MAX_PAYLOAD_BYTES=12582912
NEXUS_LOCAL_AGENT_MAX_RESULT_BYTES=12582912
NEXUS_LOCAL_AGENT_MAX_LOG_BYTES=4096

NEXUS_LOCAL_AGENT_BOOTSTRAP_ENABLED=false
NEXUS_LOCAL_AGENT_BOOTSTRAP_KEY_ID=
NEXUS_LOCAL_AGENT_BOOTSTRAP_SECRET=
NEXUS_LOCAL_AGENT_BOOTSTRAP_MAX_SKEW_SECONDS=60
NEXUS_LOCAL_AGENT_BOOTSTRAP_PER_MINUTE=5
NEXUS_LOCAL_AGENT_BOOTSTRAP_PER_HOUR=20

# Usada apenas pelo cliente de homologação; mantenha HTTPS.
NEXUS_LOCAL_AGENT_BOOTSTRAP_URL=
