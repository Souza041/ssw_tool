# Acrescentar ao .env existente. Não reutilizar credenciais gravadas nos HARs.
LG_POD_DB_HOST=127.0.0.1
LG_POD_DB_PORT=3306
LG_POD_DB_USER=
LG_POD_DB_PASSWORD=
LG_POD_DB_NAME=lg_pod

LG_POD_USER=
LG_POD_PASSWORD=
LG_POD_CARRIER=ROBR_SC
# Janela da emissão da NF, independente do período de criação dos comprovantes.
LG_POD_NF_DATA_INICIAL=2025-01-01
LG_POD_ENVIO_HABILITADO=false
LG_POD_TIMEOUT_MS=60000
LG_POD_MAX_REGISTROS=20000
# Proxy opcional, independente das demais automações.
LG_POD_PROXY_SERVER=
LG_POD_PROXY_USER=
LG_POD_PROXY_PASSWORD=
