# Ambientes virtuais
venv/
.venv/

# Cache Python
__pycache__/
*.py[cod]
*$py.class

# Variáveis de ambiente
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Downloads e arquivos temporários
downloads/
temp/
tmp/

# Arquivos de saída
outputs/downloads/
outputs/xml/
outputs/metricas_snapshots/
outputs/*.xlsx
outputs/*.xls
outputs/*.csv

# Snapshots antigos do módulo de métricas
modules/metricas/snapshots/

# Arquivos gerados
*.xlsx
*.xls
*.csv
*.sswweb

# IDEs e editores
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Dados publicados do dashboard de incidentes
data/incidentes/current/*
data/incidentes/history/*

# Mantém somente a estrutura das pastas
!data/incidentes/current/.gitkeep
!data/incidentes/history/.gitkeep