SSW_BASE_URL=https://sistema.ssw.inf.br
SSW_DOMINIO=
SSW_CPF=
SSW_USUARIO=
SSW_SENHA=
SSW_UNIDADE=CWB

SSW_TIMEOUT=60

# Sessão web: obrigatório. Gerar fora do repositório com
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SSW_ENVIRONMENT=production
SSW_SESSION_SECRET_KEY=

# BOT de ocorrência 73
OCORRENCIA_73_ENABLED=false
OCORRENCIA_73_DRY_RUN=true
OC73_ENVIO_HABILITADO=NAO
OC73_OBSERVABILIDADE_USUARIOS=
OC73_ALERTA_EXECUTANDO_MINUTOS=120

# Diagnóstico OC73: usar conta dedicada com privilégios mínimos de leitura.
OC73_DIAGNOSTICO_DB_HOST=
OC73_DIAGNOSTICO_DB_PORT=3306
OC73_DIAGNOSTICO_DB_NAME=
OC73_DIAGNOSTICO_DB_USER=
OC73_DIAGNOSTICO_DB_PASSWORD=

OCORRENCIA_73_SSW_DOMINIO=
OCORRENCIA_73_SSW_CPF=
OCORRENCIA_73_SSW_USUARIO=
OCORRENCIA_73_SSW_SENHA=

# Whirlpool: armazenamento privado, fora de /downloads e dos arquivos estaticos.
WHIRLPOOL_DATA_DIR=var/whirlpool
WHIRLPOOL_PORTAL_ENABLED=false
WHIRLPOOL_PORTAL_DRY_RUN=false
WHIRLPOOL_PORTAL_AUTHORIZED_USERS=
WHIRLPOOL_PORTAL_MAX_TRANSPORTS=10
WHIRLPOOL_PORTAL_TIMEOUT_MS=45000
WHIRLPOOL_PORTAL_NAVIGATION_TIMEOUT_MS=90000
WHIRLPOOL_PORTAL_MAX_PDF_BYTES=26214400
WHIRLPOOL_PORTAL_URL_1=
WHIRLPOOL_PORTAL_URL_2=
WHIRLPOOL_PORTAL_USER_1=
WHIRLPOOL_PORTAL_PASSWORD_1=
WHIRLPOOL_PORTAL_USER_2=
WHIRLPOOL_PORTAL_PASSWORD_2=
WHIRLPOOL_PORTAL_ALLOWED_HOSTS=
WHIRLPOOL_PROXY_SERVER=
WHIRLPOOL_PROXY_USER=
WHIRLPOOL_PROXY_PASSWORD=
