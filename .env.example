SSW_BASE_URL=https://tms.ssw.inf.br
SSW_DOMINIO=
SSW_CPF=
SSW_USUARIO=
SSW_SENHA=
SSW_UNIDADE=CWB

SSW_TIMEOUT=60
SSW_AUTH_MODE=browser
SSW_HUMAN_LOGIN_TIMEOUT=900
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# Nexus Local Agent — VPS. Todos os recursos permanecem opt-in.
NEXUS_LOCAL_AGENT_ENABLED=false
NEXUS_SSW_DELEGATION_ENABLED=false
NEXUS_SSW_DELEGATED_TASKS=ssw.documentos_gce,ssw.op001.nfd,ssw.op001.transporte,ssw.session.close
NEXUS_SSW_REMOTE_AUTH_ENABLED=false
NEXUS_SSW_REMOTE_AUTH_AGENT_ID=windows-corporativo-01
NEXUS_SSW_REMOTE_AUTH_TIMEOUT_SECONDS=960
NEXUS_SSW_REMOTE_AUTH_REQUEST_TTL_SECONDS=960
NEXUS_SSW_REMOTE_AUTH_PER_MINUTE=5
NEXUS_SSW_REMOTE_AUTH_MAX_PENDING=50
NEXUS_LOCAL_AGENT_DB=/var/lib/nexus/local-agent.sqlite3
NEXUS_LOCAL_AGENT_TOKENS_JSON={}
NEXUS_LOCAL_AGENT_ALLOWED_TASKS=system.ping
NEXUS_LOCAL_AGENT_AGENT_TASKS_JSON={}
NEXUS_LOCAL_AGENT_LEASE_SECONDS=120
NEXUS_LOCAL_AGENT_MAX_PAYLOAD_BYTES=12582912
NEXUS_LOCAL_AGENT_MAX_RESULT_BYTES=12582912
NEXUS_LOCAL_AGENT_MAX_LOG_BYTES=4096
NEXUS_LOCAL_AGENT_BOOTSTRAP_ENABLED=false
NEXUS_LOCAL_AGENT_BOOTSTRAP_KEY_ID=
NEXUS_LOCAL_AGENT_BOOTSTRAP_SECRET=
NEXUS_LOCAL_AGENT_BOOTSTRAP_MAX_SKEW_SECONDS=60
NEXUS_LOCAL_AGENT_BOOTSTRAP_PER_MINUTE=5
NEXUS_LOCAL_AGENT_BOOTSTRAP_PER_HOUR=20

# Nexus Local Agent — processo Windows. Use arquivo privado separado da VPS.
NEXUS_LOCAL_AGENT_SERVER_URL=
NEXUS_LOCAL_AGENT_ID=
NEXUS_LOCAL_AGENT_TOKEN=
NEXUS_LOCAL_AGENT_POLL_SECONDS=5
NEXUS_LOCAL_AGENT_REQUEST_TIMEOUT_SECONDS=15
NEXUS_LOCAL_AGENT_ALLOW_INSECURE_HTTP=false
NEXUS_LOCAL_AGENT_SSW_HANDLERS_ENABLED=false
NEXUS_LOCAL_AGENT_SSW_TASKS=
NEXUS_LOCAL_AGENT_RUNTIME_ENV_FILE=
NEXUS_OP001_MAX_UPLOAD_BYTES=8388608

# Sessão web: obrigatório. Gerar fora do repositório com
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SSW_ENVIRONMENT=production
SSW_SESSION_SECRET_KEY=

# BOT de ocorrência 73
OCORRENCIA_73_ENABLED=false
OCORRENCIA_73_DRY_RUN=true
OC73_ENVIO_HABILITADO=NAO
OC73_OBSERVABILIDADE_USUARIOS=
OC73_ALERTA_EXECUTANDO_MINUTOS=120

# Diagnóstico OC73: usar conta dedicada com privilégios mínimos de leitura.
OC73_DIAGNOSTICO_DB_HOST=
OC73_DIAGNOSTICO_DB_PORT=3306
OC73_DIAGNOSTICO_DB_NAME=
OC73_DIAGNOSTICO_DB_USER=
OC73_DIAGNOSTICO_DB_PASSWORD=

OCORRENCIA_73_SSW_DOMINIO=
OCORRENCIA_73_SSW_CPF=
OCORRENCIA_73_SSW_USUARIO=
OCORRENCIA_73_SSW_SENHA=

# Whirlpool: armazenamento privado, fora de /downloads e dos arquivos estaticos.
WHIRLPOOL_DATA_DIR=var/whirlpool
WHIRLPOOL_PORTAL_ENABLED=false
WHIRLPOOL_PORTAL_DRY_RUN=false
WHIRLPOOL_PORTAL_AUTHORIZED_USERS=
WHIRLPOOL_PORTAL_MAX_TRANSPORTS=10
WHIRLPOOL_PORTAL_TIMEOUT_MS=45000
WHIRLPOOL_PORTAL_NAVIGATION_TIMEOUT_MS=90000
WHIRLPOOL_PORTAL_MAX_PDF_BYTES=26214400
WHIRLPOOL_PORTAL_URL_1=
WHIRLPOOL_PORTAL_URL_2=
WHIRLPOOL_PORTAL_USER_1=
WHIRLPOOL_PORTAL_PASSWORD_1=
WHIRLPOOL_PORTAL_USER_2=
WHIRLPOOL_PORTAL_PASSWORD_2=
WHIRLPOOL_PORTAL_ALLOWED_HOSTS=
WHIRLPOOL_PROXY_SERVER=
WHIRLPOOL_PROXY_USER=
WHIRLPOOL_PROXY_PASSWORD=

# QA na mesma VPS: diretório absoluto, dedicado e fora do checkout.
SSW_QA_MODE=false
SSW_QA_DATA_DIR=

# Health Center: banco automationx e monitor de dependências externas.
# O monitor permanece inerte até as duas flags abaixo serem true.
HEALTH_CENTER_ENABLED=false
AUTOMATION_DB_HOST=127.0.0.1
AUTOMATION_DB_PORT=3306
AUTOMATION_DB_USER=
AUTOMATION_DB_PASSWORD=
AUTOMATION_DB_NAME=automationx
HEALTH_DB_CONNECT_TIMEOUT=2
HEALTH_DB_READ_TIMEOUT=2
HEALTH_DB_WRITE_TIMEOUT=2

HEALTH_DEPENDENCY_MONITOR_ENABLED=false
HEALTH_DEPENDENCY_SSW_ENABLED=false
HEALTH_DEPENDENCY_SSW_URL=
HEALTH_DEPENDENCY_SSW_HTTP_METHOD=HEAD
# Hosts exatos, separados por vírgula. Vazio bloqueia todos os destinos.
HEALTH_DEPENDENCY_ALLOWED_HOSTS=
HEALTH_DEPENDENCY_INTERVAL_SECONDS=60
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=5
HEALTH_DEPENDENCY_MAX_CONCURRENCY=4
HEALTH_DEPENDENCY_RETRIES=1
HEALTH_DEPENDENCY_FAILURE_THRESHOLD=3
HEALTH_DEPENDENCY_RECOVERY_THRESHOLD=2
HEALTH_DEPENDENCY_STALE_AFTER_SECONDS=300
HEALTH_DEPENDENCY_ALERT_COOLDOWN_SECONDS=1800
